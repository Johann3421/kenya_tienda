# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Kenya Tienda
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Kenya Tienda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.kenya.com.pe

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Base de datos PostgreSQL ─────────────────────────────────────────────────
# postgres-prod es el hostname interno del contenedor PostgreSQL en Dokploy.
# Solo funciona dentro del servidor Dokploy (red interna Docker).
DB_CONNECTION=pgsql
DB_HOST=postgres-prod
DB_PORT=5432
DB_DATABASE=kenya_tienda
DB_USERNAME=kenya_app
DB_PASSWORD=

# ── APIs externas ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Token de seguridad para los endpoints de enriquecimiento ────────────────
ENRICH_TOKEN=kenya2026

# ── Cache / sesión ───────────────────────────────────────────────────────────
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public
FILESYSTEM_DRIVER=public
FILESYSTEM_CLOUD=s3

RUN_MIGRATIONS=false
