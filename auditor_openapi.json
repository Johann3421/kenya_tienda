clean, normalized JSON list.\n\n- Results are **deduplicated by nro_parte** (latest extraction wins).\n- All spec columns are mapped to standard snake_case keys.\n- Designed to be consumed by external agents and product websites.\n\nExample:\n    GET /api/v1/fichas/catalog?marca=KENYA+TECHNOLOGY&limit=500","operationId":"get_catalog_api_api_v1_fichas_catalog_get","parameters":[{"name":"marca","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by brand, e.g. 'KENYA TECHNOLOGY'","title":"Marca"},"description":"Filter by brand, e.g. 'KENYA TECHNOLOGY'"},{"name":"categoria","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Categoria"}},{"name":"estado","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Estado"}},{"name":"search","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Search"}},{"name":"skip","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Skip"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":2000,"minimum":1,"default":200,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/fichas/video-specs":{"get":{"tags":["Fichas Producto"],"summary":"Fichas Video Specs","description":"Devuelve los specs de video/gráficos extraídos de las fichas técnicas PDF\nde Kenya Technology.\n\nLos datos son generados por scripts/extract_video_specs.py y almacenados\nen backend/app/data/kenya_video_specs.json.","operationId":"fichas_video_specs_api_v1_fichas_video_specs_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/fichas/summary":{"get":{"tags":["Fichas Producto"],"summary":"Fichas Summary","description":"Filtered aggregate stats for KPI cards (total, con_precio, sin_precio, volatility).","operationId":"fichas_summary_api_v1_fichas_summary_get","parameters":[{"name":"acuerdo_marco","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Acuerdo Marco"}},{"name":"catalogo","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Catalogo"}},{"name":"categoria","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Categoria"}},{"name":"marca","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Marca"}},{"name":"estado","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Estado"}},{"name":"search","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Search"}},{"name":"con_precio","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Con Precio"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/fichas/filters/{col_name}":{"get":{"tags":["Fichas Producto"],"summary":"Get Fichas Filter Values","description":"Return distinct non-null values for a fichas column (for Excel-like dropdowns).","operationId":"get_fichas_filter_values_api_v1_fichas_filters__col_name__get","parameters":[{"name":"col_name","in":"path","required":true,"schema":{"type":"string","title":"Col Name"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/fichas/stats":{"get":{"tags":["Fichas Producto"],"summary":"Get Fichas Stats","description":"Aggregated statistics for the fichas dashboard panel.","operationId":"get_fichas_stats_api_v1_fichas_stats_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/fichas/precio-stats":{"get":{"tags":["Fichas Producto"],"summary":"Get Precio Stats","description":"Coverage and volatility stats for enriched prices.","operationId":"get_precio_stats_api_v1_fichas_precio_stats_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/fichas/enrich-precios":{"post":{"tags":["Fichas Producto"],"summary":"Enrich Precios","description":"Match fichas_producto ↔ purchase_orders by nro_parte and compute a\ncanonical reference price using epsilon-neighborhood mode clustering.\n\nAlgorithm (Discrete Math — proximity equivalence classes):\n  - Sort all prices for a given nro_parte.\n  - Build clusters: greedy scan; a price joins the current cluster if it\n    falls within ε=5% of the cluster’s first element (anchor).\n    Formally: (p₁, p₂) ∈ R  ⇔  p₂ ≤ p₁ × (1+ε).\n  - Select the densest cluster (most orders at that price zone).\n  - Canonical price = median of the densest cluster.\n  - Volatility = (max − min) / global_median × 100  (% spread).","operationId":"enrich_precios_api_v1_fichas_enrich_precios_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/fichas/all":{"delete":{"tags":["Fichas Producto"],"summary":"Delete All Fichas","description":"Truncate the fichas_producto table. Used to clear duplicates before a clean re-scrape.","operationId":"delete_all_fichas_api_v1_fichas_all_delete","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/v1/fichas/alertas-suspendidas":{"get":{"tags":["Fichas Producto"],"summary":"Get Alertas Suspendidas","description":"Endpoint par